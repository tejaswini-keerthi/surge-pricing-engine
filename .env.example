# =============================================================================
# KAFKA CONFIGURATION
# =============================================================================
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC_RIDE_REQUESTS=ride-requests
KAFKA_TOPIC_SURGE_RESULTS=surge-results
KAFKA_TOPIC_FEATURES=ride-features
KAFKA_TOPIC_DLQ=ride-requests-dlq
KAFKA_GROUP_ID=surge-pricing-group
KAFKA_AUTO_OFFSET_RESET=earliest

# =============================================================================
# CASSANDRA CONFIGURATION
# =============================================================================
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=surge_pricing
CASSANDRA_REPLICATION_FACTOR=1

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_FEATURE_DB=1
REDIS_TTL_SECONDS=120

# =============================================================================
# FASTAPI CONFIGURATION
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# =============================================================================
# SIMULATOR CONFIGURATION
# =============================================================================
SIMULATOR_EVENTS_PER_SECOND=1000
SIMULATOR_NUM_ZONES=50
SIMULATOR_NUM_CITIES=3
SIMULATOR_BATCH_SIZE=100
SIMULATOR_DEMAND_SPIKE_PROBABILITY=0.05

# =============================================================================
# SIMULATED CITIES CONFIGURATION
# =============================================================================
# New York City
NYC_NAME=new_york
NYC_LATITUDE=40.7128
NYC_LONGITUDE=-74.0060
NYC_TIMEZONE=America/New_York
NYC_BASE_DEMAND=100
NYC_NUM_ZONES=20

# San Francisco
SF_NAME=san_francisco
SF_LATITUDE=37.7749
SF_LONGITUDE=-122.4194
SF_TIMEZONE=America/Los_Angeles
SF_BASE_DEMAND=70
SF_NUM_ZONES=15

# Chicago
CHICAGO_NAME=chicago
CHICAGO_LATITUDE=41.8781
CHICAGO_LONGITUDE=-87.6298
CHICAGO_TIMEZONE=America/Chicago
CHICAGO_BASE_DEMAND=80
CHICAGO_NUM_ZONES=15

# =============================================================================
# SURGE PRICING THRESHOLDS
# =============================================================================
SURGE_THRESHOLD_LOW=1.5
SURGE_THRESHOLD_MEDIUM=2.0
SURGE_THRESHOLD_HIGH=3.0
SURGE_MULTIPLIER_LOW=1.2
SURGE_MULTIPLIER_MEDIUM=1.5
SURGE_MULTIPLIER_HIGH=2.0
SURGE_MULTIPLIER_MAX=3.0

# =============================================================================
# WEATHER API CONFIGURATION (Open-Meteo - free, no key required)
# =============================================================================
WEATHER_UPDATE_INTERVAL_SECONDS=600
WEATHER_CACHE_TTL_SECONDS=660

# =============================================================================
# SPECIAL EVENTS CONFIGURATION
# =============================================================================
# Probability that a special event starts in any zone in any given hour
EVENTS_PROBABILITY=0.02
# How long events last in minutes (min and max)
EVENTS_MIN_DURATION_MINUTES=60
EVENTS_MAX_DURATION_MINUTES=240
# Demand multiplier range during events
EVENTS_MIN_DEMAND_MULTIPLIER=2.0
EVENTS_MAX_DEMAND_MULTIPLIER=4.0

# =============================================================================
# SUPPLY SIMULATION CONFIGURATION
# =============================================================================
# Base number of drivers per zone
SUPPLY_BASE_DRIVERS_PER_ZONE=30
# Supply reduction factors (multiplied against base)
SUPPLY_RAIN_FACTOR=0.70
SUPPLY_HEAVY_RAIN_FACTOR=0.50
SUPPLY_SNOW_FACTOR=0.60
SUPPLY_LATE_NIGHT_FACTOR=0.50
SUPPLY_RUSH_HOUR_FACTOR=1.30
SUPPLY_WEEKEND_NIGHT_FACTOR=0.65

# =============================================================================
# ML CONFIGURATION
# =============================================================================
ML_MODEL_PATH=ml/models/surge_predictor.pkl
ML_FEATURE_WINDOW_1MIN=60
ML_FEATURE_WINDOW_5MIN=300
ML_FEATURE_WINDOW_15MIN=900
ML_CONFIDENCE_THRESHOLD=0.7
ML_TRAINING_MIN_SAMPLES=1000
ML_RETRAIN_INTERVAL_HOURS=24

# =============================================================================
# HOLIDAY CONFIGURATION
# =============================================================================
HOLIDAY_COUNTRY=US
HOLIDAY_DEMAND_MULTIPLIER=1.8
HOLIDAY_EVE_DEMAND_MULTIPLIER=1.4
HOLIDAY_LOOKAHEAD_DAYS=7

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/pipeline.log
LOG_ROTATION=100 MB
LOG_RETENTION=7 days